# MkDocs build output (generated HTML — never committed; CI/hosting builds it)
/site/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# OS / editor cruft
.DS_Store
*.swp

# Packaging placeholders — build artifacts (never committed).
# NOTE: packaging/crates/Cargo.lock is NOT ignored, deliberately. It was until 2026-08-20
# (#446), and the rule that removed it is now repo-wide: every cargo tree here commits its
# lockfile, so no tree ever resolves dependencies fresh in CI. See #445 for what an
# unpinned resolve cost us, and crates/cairn-node/tests/cargo_lockfiles_tracked.rs for the
# guard that will fail if this line comes back.
packaging/pypi/dist/
packaging/crates/target/
packaging/npm/node_modules/

# Rust workspace build output (never committed)
/target/
poc/walking-skeleton/target/

# Subagent-driven-development scratch (ledger + briefs/reports/diffs)
.superpowers/
.claude/

#private stuff
untracked_for_brainstorming/

# Local PDF exports of published essays (the .md source is the tracked original)
docs/essays/*.pdf
