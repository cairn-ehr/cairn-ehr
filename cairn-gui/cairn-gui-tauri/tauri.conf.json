{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn Medications",
  "version": "0.1.0",
  "identifier": "org.cairn-ehr.med-list",
  "build": {
    "frontendDist": "src-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Cairn — Medications",
        "width": 1000,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}
